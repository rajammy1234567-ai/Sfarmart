{
  "expo": {
    "name": "S-farmart Partner",
    "slug": "sfarmart-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sfarmart24_logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sfarmart.partner"
    },
    "android": {
	"googleServicesFile": "./google-services.json",
      "package": "com.sfarmart.partner",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/sfarmart24_logo.png",
	"backgroundColor": "#ffffff"
      },
      "permissions": [
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#15803d"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "59989093-917c-4e06-9cfd-15ab65aa3aee"
      }
    },
    "owner": "sfarmart"
  }
}
