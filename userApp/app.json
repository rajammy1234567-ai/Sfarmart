{
  "expo": {
    "name": "S-farmart 24",
    "slug": "userApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/sfarmart24_logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/sfarmart24_logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sfarmart.userapp",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#16a34a"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/sfarmart24_logo.png",
          "backgroundColor": "#ffffff",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/sfarmart24_logo.png",
            "backgroundColor": "#ffffff"
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b92a3a9a-2815-457f-b3ba-739b15298d2d"
      }
    },
    "owner": "sfarmart"
  }
}
